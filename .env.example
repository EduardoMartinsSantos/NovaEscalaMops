# Copie para .env (não vai para o GitHub) e preencha. Na Vercel, cadastre as mesmas variáveis em
# Settings → Environment Variables (o DATABASE_URL é criado sozinho ao conectar o banco Neon).

# Conexão do Postgres (Neon). Ex.: postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Chave que assina o cookie de sessão. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Senha de quem ainda não trocou a própria senha (o admin pode voltar qualquer senha para esta).
SENHA_PADRAO=

# E-mail do primeiro administrador (vira admin enquanto o sistema não tiver nenhum).
ADMIN_EMAIL=
